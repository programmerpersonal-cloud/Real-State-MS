# Saxane Real Estate — Apache configuration
#
# robots.txt and sitemap.xml are generated by PHP rather than kept as static
# files: both need the site's absolute base URL, which differs between
# localhost, a LAN IP and production, and the sitemap needs the live list of
# properties. Requires mod_rewrite (enabled by default in XAMPP).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve the SEO files from the front controller.
    RewriteRule ^robots\.txt$   index.php?page=robots   [L,QSA]
    RewriteRule ^sitemap\.xml$  index.php?page=sitemap  [L,QSA]
</IfModule>

# Never serve application source or data as plain text if a rewrite is missing.
<FilesMatch "\.(sql|md|log)$">
    Require all denied
</FilesMatch>

# Long-cache fingerprinted static assets; images and fonts rarely change.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css   "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
