# Saxane Real Estate Management System — environment template
#
# Copy this file to .env and fill in the values for THIS machine:
#
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows CMD)
#     Copy-Item .env.example .env   (PowerShell)
#
# .env is git-ignored and must never be committed. This template is committed,
# so keep it in step whenever a new key is added — but never put a real
# password in it.
#
# Syntax notes:
#   - Blank lines and lines starting with # are ignored.
#   - Quote any value containing a space or a # character:  DB_PASS="p@ss #1"
#   - Leaving a key blank gives an empty string, which is what stock XAMPP
#     wants for DB_PASS.
#   - A real server environment variable of the same name overrides .env, so a
#     hosting panel can set DB_PASS without a .env file existing at all.

# ─── Environment ───────────────────────────────────────────────────────
# local | production
# APP_DEBUG prints real error text to the browser. It defaults to on when
# APP_ENV=local and MUST be false on a public site.
APP_ENV=local
APP_DEBUG=true

# ─── Database ──────────────────────────────────────────────────────────
# The stock XAMPP setup is user "root" with an empty password.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saxane_realestate
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ─── Application ───────────────────────────────────────────────────────
# Trading name used as a fallback. The live value comes from
# Settings → Company Profile once that is filled in.
APP_NAME=Saxane

# Leave blank to auto-detect from the incoming request, which is right for
# localhost, a LAN IP and most shared hosting. Set it explicitly only when
# running behind a reverse proxy or generating links from cron/CLI.
# APP_URL=https://saxane.example.com

# ─── Analytics ─────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Left blank, no
# third-party script is emitted at all — keep it blank in development.
GA_MEASUREMENT_ID=

# ─── Backups ───────────────────────────────────────────────────────────
# Where backup archives are written. MUST be a path Apache does not serve —
# an archive is the whole database plus every uploaded file in one object.
# Leave blank to use the default one level above the project, which is right
# for htdocs/<project>/<app> and wrong if the document root points straight
# at the application. The Backup dashboard warns if the resolved path turns
# out to be inside the web root.
BACKUP_PATH=D:/XAMPP/private_storage/backups

# mysqldump / mysql binaries. The defaults are the stock XAMPP locations;
# set these only if MySQL lives somewhere else on this machine.
# MYSQLDUMP_PATH=D:/XAMPP/mysql/bin/mysqldump.exe
# MYSQL_PATH=D:/XAMPP/mysql/bin/mysql.exe

# Automatic backup runs from database/tools/run_backups.php on a timer, never
# from the browser. Install it once on Windows with:
#
#   database\tools\install_scheduler.bat      (right-click, Run as administrator)
#
# and check it at any time with:
#
#   php database/tools/run_backups.php --doctor
#
# How long the scheduler may go silent before the Backup dashboard reports it
# as stopped. Make it a few times the tick interval — the default suits a task
# running every 5 to 15 minutes.
# BACKUP_SCHEDULER_STALE_MINUTES=60
