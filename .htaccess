# Saxane Real Estate — Apache configuration
#
# robots.txt and sitemap.xml are generated by PHP rather than kept as static
# files: both need the site's absolute base URL, which differs between
# localhost, a LAN IP and production, and the sitemap needs the live list of
# properties. Requires mod_rewrite (enabled by default in XAMPP).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve the SEO files from the front controller.
    RewriteRule ^robots\.txt$   index.php?page=robots   [L,QSA]
    RewriteRule ^sitemap\.xml$  index.php?page=sitemap  [L,QSA]

    # The protected document store is never reachable over HTTP. Documents are
    # delivered by index.php?page=documents&action=download, which authorises
    # the request first. storage/.htaccess denies this too — belt and braces,
    # because a single missed AllowOverride would otherwise expose title deeds.
    RewriteRule ^storage/ - [F,L]
</IfModule>

# Dotfiles are never served. .env is the one that matters: this project's root
# is also the web root under htdocs, so without this rule the database password
# is a single GET away — /.env has no handler and Apache would return it as
# plain text. .git/, .gitignore and .htaccess itself are covered by the same
# pattern. Written for both modern and legacy Apache because a host that lacks
# mod_authz_core would otherwise silently ignore the deny.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Belt and braces: name the environment files explicitly, so a server whose
# configuration strips the leading-dot rule above still refuses them.
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Never serve application source or data as plain text if a rewrite is missing.
<FilesMatch "\.(sql|md|log)$">
    Require all denied
</FilesMatch>

# Long-cache fingerprinted static assets; images and fonts rarely change.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css   "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
